# ===========================================
# tRIAL-cLIENTS Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# ------------------------------------------
# Supabase Configuration (Required)
# ------------------------------------------
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_anon_key"

# ------------------------------------------
# Edge Function Secrets (Set in Supabase Dashboard / via `supabase secrets set`)
# ------------------------------------------
# These are NOT read by the browser bundle. They are consumed inside
# Supabase Edge Functions via Deno.env.get(). Configure at:
#   https://supabase.com/dashboard/project/_/settings/functions/secrets
#
# Automatically available in every Edge Function:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#
# Required for project-brief generation (supabase/functions/generate-project):
#   GEMINI_API_KEY         Google AI Studio key (primary provider)
# Optional overrides:
#   GEMINI_MODEL           defaults to "gemini-2.5-flash"
#   GEMINI_TIMEOUT_MS      defaults to 60000
#
# Optional OpenRouter fallback (only used when Gemini has a retryable failure):
#   OPENROUTER_API_KEY
#   OPENROUTER_MODEL       defaults to "google/gemma-4-31b-it:free"
#   OPENROUTER_TIMEOUT_MS  defaults to 60000
#
# If OPENROUTER_API_KEY is not set, the generation service will use
# Gemini only. Retryable Gemini failures then surface as HTTP 503.

# ------------------------------------------
# NOTE: Legacy n8n / ClawCloud variables
# ------------------------------------------
# The following variables are NO LONGER used after the backend migration
# and can be safely removed from your local .env and your Supabase
# Edge Function secrets:
#   N8N_WEBHOOK_URL
#   N8N_CALLBACK_SECRET
